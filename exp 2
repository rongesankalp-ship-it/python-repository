#q5 Check whether the quadratic equation has real roots or imaginary roots. Display the 
roots. 
import math
a = int(input("Enter a: "))
b = int(input("Enter b: "))
c = int(input("Enter c: "))

d = b*b - 4*a*c

if d > 0:
    r1 = (-b + math.sqrt(d)) / (2*a)
    r2 = (-b - math.sqrt(d)) / (2*a)
    print("Roots are real and different")
    print("Root1:",r1)
    print("Root2:",r2)
elif d == 0:
    r = -b / (2*a)
    print("Roots are real and equal")
    print("Root:",r)
else:
    print("Roots are imaginary")


